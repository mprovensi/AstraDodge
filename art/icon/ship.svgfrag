<!-- Nave do jogador (a mesma do jogo) com chama dos motores, anel do escudo e tiros. -->
<defs>
  <linearGradient id="hull" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#2a5a8a"/><stop offset="1" stop-color="#0a1626"/>
  </linearGradient>
  <linearGradient id="wing" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#1d3d63"/><stop offset="1" stop-color="#08111f"/>
  </linearGradient>
  <linearGradient id="glass" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#e6fdff"/><stop offset="0.6" stop-color="#2aa7c9"/><stop offset="1" stop-color="#0b3248"/>
  </linearGradient>
  <linearGradient id="flame" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#fff2b0"/><stop offset="0.35" stop-color="#ffb347"/><stop offset="1" stop-color="#ff5a1f" stop-opacity="0"/>
  </linearGradient>
</defs>
<!-- Tiros (pares ciano) -->
<g stroke="#c8feff" stroke-width="9" stroke-linecap="round">
  <path d="M236 58 L236 92"/><path d="M276 58 L276 92"/>
</g>
<g stroke="#3ff0ff" stroke-width="18" stroke-linecap="round" opacity="0.25">
  <path d="M236 58 L236 92"/><path d="M276 58 L276 92"/>
</g>
<!-- Anel do escudo -->
<circle cx="256" cy="268" r="150" fill="none" stroke="#3ff0ff" stroke-opacity="0.18" stroke-width="22"/>
<circle cx="256" cy="268" r="150" fill="none" stroke="#9ffbff" stroke-opacity="0.85" stroke-width="6"/>
<!-- Chamas dos motores -->
<g transform="translate(256 268) scale(1.15) translate(-128 -128)">
  <path d="M108 202 L126 202 L117 262 Z" fill="url(#flame)"/>
  <path d="M130 202 L148 202 L139 262 Z" fill="url(#flame)"/>
  <!-- Nave -->
  <path d="M128 78 L216 176 L200 192 L146 170 L110 170 L56 192 L40 176 Z"
        fill="url(#wing)" stroke="#3ff0ff" stroke-width="6" stroke-linejoin="round"/>
  <path d="M216 176 L222 150 L206 158 Z" fill="#3ff0ff"/>
  <path d="M40 176 L34 150 L50 158 Z" fill="#3ff0ff"/>
  <path d="M72 178 L112 154" stroke="#ff4fd8" stroke-width="7" stroke-linecap="round"/>
  <path d="M184 178 L144 154" stroke="#ff4fd8" stroke-width="7" stroke-linecap="round"/>
  <path d="M128 14 L150 84 L154 178 L128 200 L102 178 L106 84 Z"
        fill="url(#hull)" stroke="#c8feff" stroke-width="7" stroke-linejoin="round"/>
  <path d="M128 112 L128 182" stroke="#3ff0ff" stroke-opacity="0.7" stroke-width="3"/>
  <path d="M128 44 L141 86 L128 106 L115 86 Z" fill="url(#glass)" stroke="#ffffff" stroke-width="3" stroke-linejoin="round"/>
  <rect x="110" y="190" width="14" height="14" rx="3" fill="#0a1626" stroke="#ffd27a" stroke-width="3"/>
  <rect x="132" y="190" width="14" height="14" rx="3" fill="#0a1626" stroke="#ffd27a" stroke-width="3"/>
</g>
