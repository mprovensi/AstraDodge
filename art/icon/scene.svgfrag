<!-- Fundo do ícone (512x512): espaço com nebulosa magenta/ciano, estrelas e rochas do jogo
     (poeira cinza e metálico escuro) cortadas pelas bordas. A nave fica em ship.svgfrag. -->
<defs>
  <radialGradient id="ibg" cx="50%" cy="55%" r="75%">
    <stop offset="0" stop-color="#1a1f55"/>
    <stop offset="0.6" stop-color="#0a0b26"/>
    <stop offset="1" stop-color="#03030c"/>
  </radialGradient>
  <radialGradient id="neb1" cx="50%" cy="50%" r="50%">
    <stop offset="0" stop-color="#ff4fd8" stop-opacity="0.38"/>
    <stop offset="1" stop-color="#ff4fd8" stop-opacity="0"/>
  </radialGradient>
  <radialGradient id="neb2" cx="50%" cy="50%" r="50%">
    <stop offset="0" stop-color="#3ff0ff" stop-opacity="0.22"/>
    <stop offset="1" stop-color="#3ff0ff" stop-opacity="0"/>
  </radialGradient>
  <radialGradient id="rock" cx="38%" cy="32%" r="75%">
    <stop offset="0" stop-color="#b3b5bf"/>
    <stop offset="0.65" stop-color="#6c6e78"/>
    <stop offset="1" stop-color="#3a3c45"/>
  </radialGradient>
  <linearGradient id="steel" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#2e3545"/>
    <stop offset="1" stop-color="#0d1017"/>
  </linearGradient>
</defs>
<rect width="512" height="512" fill="url(#ibg)"/>
<ellipse cx="150" cy="330" rx="230" ry="170" fill="url(#neb1)"/>
<ellipse cx="400" cy="140" rx="200" ry="150" fill="url(#neb2)"/>
<!-- Estrelas e riscos de velocidade -->
<g fill="#dbe8ff">
  <circle cx="64" cy="60" r="3" opacity="0.8"/><circle cx="300" cy="40" r="2.5" opacity="0.6"/>
  <circle cx="470" cy="250" r="3" opacity="0.6"/><circle cx="40" cy="250" r="2" opacity="0.5"/>
  <circle cx="120" cy="470" r="2.5" opacity="0.6"/><circle cx="350" cy="480" r="2" opacity="0.5"/>
  <circle cx="200" cy="120" r="2" opacity="0.5"/><circle cx="440" cy="400" r="2.5" opacity="0.6"/>
</g>
<g stroke="#bcd6ff" stroke-linecap="round" opacity="0.45">
  <path d="M90 140 L90 186" stroke-width="3"/><path d="M420 300 L420 352" stroke-width="3"/>
  <path d="M60 330 L60 360" stroke-width="2"/><path d="M470 80 L470 112" stroke-width="2"/>
  <path d="M300 410 L300 440" stroke-width="2"/>
</g>
<!-- Poeira cinza (canto superior esquerdo, cortada pela borda) -->
<g transform="translate(-18 -26) scale(0.62)">
  <path d="M128 12 L176 22 L214 54 L240 104 L232 158 L208 204 L160 238 L104 240 L58 214 L22 170 L16 116 L36 64 L80 26 Z"
        fill="url(#rock)" stroke="#d6d8e0" stroke-width="7" stroke-linejoin="round"/>
  <circle cx="96" cy="96" r="22" fill="#55575f" stroke="#8d8f98" stroke-width="3"/>
  <circle cx="164" cy="150" r="30" fill="#4d4f57" stroke="#8a8c95" stroke-width="3"/>
  <circle cx="176" cy="78" r="10" fill="#5a5c64"/>
</g>
<!-- Poeira pequena (direita) -->
<g transform="translate(398 168) scale(0.3)">
  <path d="M128 12 L176 22 L214 54 L240 104 L232 158 L208 204 L160 238 L104 240 L58 214 L22 170 L16 116 L36 64 L80 26 Z"
        fill="url(#rock)" stroke="#d6d8e0" stroke-width="9" stroke-linejoin="round"/>
  <circle cx="110" cy="110" r="30" fill="#55575f"/>
</g>
<!-- Metálico escuro (canto inferior direito, cortado pela borda) -->
<g transform="translate(352 352) scale(0.72)">
  <path d="M84 10 L172 10 L236 70 L246 140 L218 214 L150 246 L90 244 L28 206 L10 132 L26 62 Z"
        fill="url(#steel)" stroke="#8ea0c2" stroke-width="8" stroke-linejoin="round"/>
  <path d="M40 98 L216 92 M60 170 L200 176" stroke="#465066" stroke-width="6"/>
  <g fill="#8ea0c2"><circle cx="60" cy="80" r="7"/><circle cx="190" cy="74" r="7"/><circle cx="70" cy="200" r="7"/></g>
</g>
